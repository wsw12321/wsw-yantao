---
// src/layouts/login_Layout.astro
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      /* ===== 导航栏 ===== */
      nav {
        width: 100%;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;          /* 移动端允许换行 */
      }

      .nav-brand {
        font-size: 1.5rem;
        font-weight: bold;
        color: white;
      }

      /* ===== 汉堡按钮（桌面端隐藏） ===== */
      .menu-toggle {
        display: none;
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: white;
        padding: 0.25rem;
        line-height: 1;
      }

      /* ===== 导航链接区域 ===== */
      .main-nav {
        display: flex;
        gap: 0.25rem;
        align-items: center;
      }

      .main-nav a,
      .main-nav span {
        color: white;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-size: 0.95rem;
        font-weight: 500;
        transition: background-color 0.2s;
        white-space: nowrap;
      }

      .main-nav a:hover {
        background: rgba(255, 255, 255, 0.2);
      }

      /* ===== 移动端响应式 ===== */
      @media (max-width: 768px) {
        .menu-toggle {
          display: block;        /* 显示汉堡按钮 */
        }

        .main-nav {
          display: none;         /* 默认隐藏导航 */
          flex-direction: column;
          width: 100%;
          padding-top: 0.75rem;
          gap: 0.25rem;
        }

        .main-nav.open {
          display: flex;         /* 点击后展开 */
        }

        .main-nav a,
        .main-nav span {
          padding: 0.7rem 1rem;
          border-radius: 6px;
          text-align: left;
          width: 100%;
        }

        .main-nav a:hover {
          background: rgba(255, 255, 255, 0.15);
        }
      }

      /* ===== 主内容 ===== */
      main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        width: 100%;
      }
    </style>
  </head>
  <body>
    <nav>
      <span class="nav-brand">🔐 YT-Physics</span>

      <!-- 汉堡按钮（移动端可见） -->
      <button class="menu-toggle" id="menu-toggle" aria-label="菜单">☰</button>

      <!-- 导航链接 -->
      <div class="main-nav" id="nav-links">
        <a href="/">首页</a>
        <a href="/login">登录</a>
        <a href="/register">注册</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <script>
      // ===== 汉堡菜单切换 =====
      function initMenu() {
        const toggle = document.getElementById('menu-toggle');
        const nav = document.getElementById('nav-links');
        if (!toggle || !nav) return;

        toggle.addEventListener('click', () => {
          const isOpen = nav.classList.toggle('open');
          toggle.textContent = isOpen ? '✕' : '☰';
        });

        // 点击链接后自动收起
        nav.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).tagName === 'A') {
            nav.classList.remove('open');
            toggle.textContent = '☰';
          }
        });
      }

      initMenu();

      // ===== 登录状态检测 =====
      async function updateNav() {
        try {
          const res = await fetch('/api/me');
          const data = await res.json();
          const navLinks = document.getElementById('nav-links');

          if (data.authenticated && navLinks) {
            navLinks.innerHTML = `
              <a href="/">首页</a>
              <a href="/dashboard">控制台</a>
              <span>欢迎, ${data.user.username}</span>
              <a href="#" id="logout-btn">登出</a>
            `;

            document.getElementById('logout-btn')?.addEventListener('click', async (e) => {
              e.preventDefault();
              await fetch('/api/logout', { method: 'POST' });
              window.location.href = '/';
            });
          }
        } catch {
          // 未登录，保持默认
        }
      }

      updateNav();
    </script>
  </body>
</html>