
---
// src/layouts/login_Layout.astro
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      /* ===== 导航栏 ===== */
      nav {
        width: 100%;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
      }

      .nav-brand {
        font-size: 1.5rem;
        font-weight: bold;
        color: white;
        z-index: 10;
      }

      /* 导航链接容器 */
      #nav-links {
        display: flex;
        align-items: center;
        gap: 0.25rem;
      }

      #nav-links a,
      #nav-links span {
        color: white;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        transition: background 0.3s;
        white-space: nowrap;
      }

      #nav-links a:hover {
        background: rgba(255, 255, 255, 0.2);
      }

      /* ===== 汉堡按钮 ===== */
      .hamburger {
        display: none;           /* 桌面端隐藏 */
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 36px;
        height: 36px;
        cursor: pointer;
        z-index: 10;
        background: none;
        border: none;
        padding: 4px;
      }

      .hamburger span {
        display: block;
        width: 100%;
        height: 3px;
        background: white;
        border-radius: 3px;
        transition: transform 0.3s ease, opacity 0.3s ease;
        transform-origin: center;
      }

      /* 汉堡 → 叉号动画 */
      .hamburger.active span:nth-child(1) {
        transform: translateY(8px) rotate(45deg);
      }
      .hamburger.active span:nth-child(2) {
        opacity: 0;
      }
      .hamburger.active span:nth-child(3) {
        transform: translateY(-8px) rotate(-45deg);
      }

      /* 遮罩层 */
      .nav-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        z-index: 4;
      }
      .nav-overlay.active {
        display: block;
      }

      /* ===== 移动端样式 ===== */
      @media (max-width: 640px) {
        .hamburger {
          display: flex;
        }

        #nav-links {
          /* 默认隐藏 */
          position: fixed;
          top: 0;
          right: -280px;        /* 移出屏幕 */
          width: 260px;
          height: 100vh;
          flex-direction: column;
          align-items: stretch;
          background: linear-gradient(180deg, #5a67d8 0%, #6b46c1 100%);
          padding: 5rem 1.5rem 2rem;
          gap: 0.5rem;
          z-index: 5;
          transition: right 0.35s cubic-bezier(0.4, 0, 0.2, 1);
          box-shadow: -4px 0 30px rgba(0, 0, 0, 0.3);
          overflow-y: auto;
        }

        #nav-links.open {
          right: 0;             /* 滑入 */
        }

        #nav-links a,
        #nav-links span {
          padding: 0.85rem 1rem;
          border-radius: 8px;
          font-size: 1.05rem;
          text-align: left;
        }

        #nav-links a:hover {
          background: rgba(255, 255, 255, 0.15);
        }
      }

      /* ===== 主内容 ===== */
      main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        width: 100%;
      }
    </style>
  </head>
  <body>
    <nav>
      <span class="nav-brand">🔐 YT-Physics</span>

      <!-- 汉堡按钮（移动端可见） -->
      <button class="hamburger" id="hamburger-btn" aria-label="菜单">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <!-- 导航链接 -->
      <div id="nav-links">
        <a href="/">首页</a>
        <a href="/login">登录</a>
        <a href="/register">注册</a>
      </div>
    </nav>

    <!-- 遮罩层 -->
    <div class="nav-overlay" id="nav-overlay"></div>

    <main>
      <slot />
    </main>

    <script>
      // ===== 折叠菜单逻辑 =====
      function initHamburger() {
        const btn     = document.getElementById('hamburger-btn');
        const links   = document.getElementById('nav-links');
        const overlay = document.getElementById('nav-overlay');

        if (!btn || !links || !overlay) return;

        function toggle() {
          btn.classList.toggle('active');
          links.classList.toggle('open');
          overlay.classList.toggle('active');
        }

        function close() {
          btn.classList.remove('active');
          links.classList.remove('open');
          overlay.classList.remove('active');
        }

        btn.addEventListener('click', toggle);
        overlay.addEventListener('click', close);

        // 点击菜单内的链接后自动关闭
        links.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).tagName === 'A') close();
        });
      }

      initHamburger();

      // ===== 登录状态检测 =====
      async function updateNav() {
        try {
          const res  = await fetch('/api/me');
          const data = await res.json();
          const navLinks = document.getElementById('nav-links');

          if (data.authenticated && navLinks) {
            navLinks.innerHTML = `
              <a href="/">首页</a>
              <a href="/dashboard">控制台</a>
              <span style="color: white;">欢迎, ${data.user.username}</span>
              <a href="#" id="logout-btn">登出</a>
            `;

            document.getElementById('logout-btn')?.addEventListener('click', async (e) => {
              e.preventDefault();
              await fetch('/api/logout', { method: 'POST' });
              window.location.href = '/';
            });

            // 内容替换后重新绑定 "点击链接关闭菜单"
            initHamburger();
          }
        } catch {
          // 未登录，保持默认
        }
      }

      updateNav();
    </script>
  </body>
</html>